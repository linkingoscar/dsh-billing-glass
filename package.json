{
  "name": "dsh-billing-glass",
  "version": "0.4.1",
  "description": "Liquid-glass billing overlay for the DeepSeek Harness Web GUI: provider balances, session cost, daily spend and token buckets. DeepSeek-first with an extensible provider registry.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.mjs\"",
    "build:client": "node scripts/build-client.js",
    "sync:providers": "node scripts/sync-providers.js",
    "sync:providers:check": "node scripts/sync-providers.js --check",
    "check:upstream": "node scripts/check-upstream.mjs",
    "typecheck": "tsc -p tsconfig.checkjs.json",
    "lint": "oxlint .",
    "check:generated": "npm run build:client && npm run sync:providers:check && git diff --exit-code -- lib/client.js lib/providers/catalog.generated.js",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@types/node": "^22.20.1",
    "oxlint": "^1.15.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkingoscar/dsh-billing-glass.git"
  },
  "bugs": {
    "url": "https://github.com/linkingoscar/dsh-billing-glass/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "billing",
    "balance",
    "glassmorphism",
    "liquid-glass",
    "web"
  ],
  "license": "Apache-2.0"
}
